rules_version = '2';

// ============================================================================
// KyriosStems - Firestore Security Rules
//
// Princípio: a biblioteca é pública para leitura e restrita para escrita.
// A autorização não depende da interface: exige a custom claim `admin: true`
// no token do Firebase Authentication.
//
// Aplicar com:
//   firebase deploy --only firestore:rules
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Funções auxiliares
    // ------------------------------------------------------------------------

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isString(value) {
      return value is string;
    }

    function isNumber(value) {
      return value is number || value is int || value is float;
    }

    function isNullOrNumber(value) {
      return value == null || isNumber(value);
    }

    function isNullOrString(value) {
      return value == null || isString(value);
    }

    function isStringList(value) {
      return value is list && value.size() <= 20
        && (value.size() == 0 || value.join('|').size() <= 400);
    }

    function maxLen(value, limit) {
      return !isString(value) || value.size() <= limit;
    }

    /** Campos permitidos na música. Impede gravação de campos arbitrários. */
    function songShape(data) {
      return data.keys().hasOnly([
        'title', 'artist', 'album', 'key', 'bpm', 'timeSignature', 'duration',
        'category', 'tags', 'coverUrl', 'description', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasAll(['title', 'artist', 'createdAt', 'updatedAt']);
    }

    /** Campos permitidos na sessão. */
    function sessionShape(data) {
      return data.keys().hasOnly([
        'songId', 'daw', 'dawVersion', 'version', 'description', 'format',
        'sampleRate', 'bitDepth', 'duration', 'packagePath', 'packageSize',
        'files', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasAll(['songId', 'daw', 'version', 'createdAt', 'updatedAt']);
    }

    /** Arquivos catalogados na sessão. Uma sessão pode não ter arquivos ainda. */
    function filesShape(files) {
      return files is list
        && files.size() <= 300
        && (files.size() == 0 || files[0].keys().hasOnly([
             'name', 'path', 'storagePath', 'size', 'category', 'contentType'
           ]));
    }

    /**
     * Validação de uma música.
     * Roda sobre o documento resultante, então cobre criação e atualização,
     * inclusive atualizações parciais.
     */
    function validSong(data) {
      return songShape(data)
        && isString(data.title) && data.title.size() >= 1 && data.title.size() <= 200
        && isString(data.artist) && data.artist.size() >= 1 && data.artist.size() <= 200
        && maxLen(data.album, 200)
        && maxLen(data.key, 8)
        && maxLen(data.timeSignature, 8)
        && maxLen(data.category, 60)
        && maxLen(data.coverUrl, 2048)
        && maxLen(data.description, 2000)
        && isNullOrNumber(data.bpm)
        && (data.bpm == null || (data.bpm >= 20 && data.bpm <= 400))
        && isNullOrNumber(data.duration)
        && (data.duration == null || data.duration > 0)
        && isStringList(data.tags)
        && isString(data.createdAt)
        && isString(data.updatedAt);
    }

    /** Validação de uma sessão. */
    function validSession(data) {
      return sessionShape(data)
        && isString(data.songId) && data.songId.size() >= 1 && data.songId.size() <= 128
        && isString(data.daw) && data.daw.size() >= 1 && data.daw.size() <= 60
        && maxLen(data.dawVersion, 40)
        && maxLen(data.description, 1000)
        && maxLen(data.format, 20)
        && maxLen(data.packagePath, 1024)
        && isNumber(data.version) && data.version >= 1 && data.version <= 999
        && isNullOrNumber(data.sampleRate)
        && (data.sampleRate == null || (data.sampleRate >= 8000 && data.sampleRate <= 384000))
        && isNullOrNumber(data.bitDepth)
        && (data.bitDepth == null || (data.bitDepth >= 8 && data.bitDepth <= 64))
        && isNullOrNumber(data.duration)
        && (data.duration == null || data.duration > 0)
        && isNullOrNumber(data.packageSize)
        && (data.packageSize == null || data.packageSize > 0)
        && isString(data.createdAt)
        && isString(data.updatedAt)
        && filesShape(data.files);
    }

    // ------------------------------------------------------------------------
    // Músicas
    // ------------------------------------------------------------------------

    match /songs/{songId} {
      // O catálogo é público.
      allow read: if true;

      allow create: if isAdmin() && validSong(request.resource.data);
      allow update: if isAdmin() && validSong(request.resource.data);
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------------
    // Sessões
    // ------------------------------------------------------------------------

    match /sessions/{sessionId} {
      allow read: if true;

      allow create: if isAdmin() && validSession(request.resource.data);
      allow update: if isAdmin() && validSession(request.resource.data);
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------------
    // Qualquer outro caminho é negado por padrão.
    // ------------------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}