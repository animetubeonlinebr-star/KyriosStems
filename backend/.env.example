# KyriosStems - variáveis de ambiente do backend
#
# Copie para backend/.env e preencha com os valores reais.
# O arquivo .env NUNCA é versionado (veja .gitignore).

# --- Aiven PostgreSQL -------------------------------------------------------
KYRIOS_DB_HOST=kyrios-animetubeonlinebr-kyrios-stems.f.aivencloud.com
KYRIOS_DB_PORT=25580
KYRIOS_DB_NAME=defaultdb
KYRIOS_DB_USER=avnadmin
KYRIOS_DB_PASSWORD=

# Caminho da Project CA do Aiven. O padrão já aponta para o arquivo versionado.
# A CA é um certificado público: não é segredo e pode ficar no repositório.
# KYRIOS_DB_CA_PATH=./certs/aiven-ca.pem

# --- Servidor HTTP ----------------------------------------------------------
KYRIOS_PORT=8080

# Origens autorizadas (CORS), separadas por vírgula.
# Em produção: https://animetubeonlinebr-star.github.io
KYRIOS_ALLOWED_ORIGINS=http://localhost:12000

# --- Autenticação -----------------------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
KYRIOS_JWT_SECRET=
KYRIOS_TOKEN_TTL=43200

# --- Google Drive -----------------------------------------------------------
# Conta Google dedicada ao KyriosStems (OAuth), não uma conta pessoal.
KYRIOS_DRIVE_CLIENT_ID=
KYRIOS_DRIVE_CLIENT_SECRET=
KYRIOS_DRIVE_REFRESH_TOKEN=
KYRIOS_DRIVE_FOLDER_ID=
