rules_version = '2';

// ============================================================================
// KyriosStems - Cloud Storage Security Rules
//
// Estrutura:
//   sessions/{songId}/{sessionId}/{categoria}/{arquivo}
//
// Leitura pública: o download do pacote é o recurso principal da aplicação e o
// catálogo é público. Escrita e exclusão exigem a custom claim `admin: true`.
//
// Aplicar com:
//   firebase deploy --only storage
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    /**
     * Validação do envio.
     * O limite de 2 GiB acompanha UPLOAD_LIMITS.maxFileBytes da aplicação.
     */
    function validUpload() {
      return request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024 * 1024;
    }

    /** Categorias válidas, conforme declarado em js/core/constants.js. */
    function validCategory(category) {
      return category == 'package'
        || category == 'project'
        || category == 'audio'
        || category == 'aux';
    }

    match /sessions/{songId}/{sessionId}/{category}/{fileName} {
      allow read: if true;
      allow create: if isAdmin() && validCategory(category) && validUpload();
      allow update: if isAdmin() && validCategory(category) && validUpload();
      allow delete: if isAdmin();
    }

    // Qualquer outro caminho é negado por padrão.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}