# Dependências e artefatos de build
node_modules/
dist/
build/

# Arquivos de ambiente e credenciais locais
.env
.env.*
*.local
*.local.js

# Endereço local da API. Criado à mão para apontar o frontend a um backend
# local; em produção o endereço fica em js/core/config.js.
js/core/config.local.js

# Credenciais de serviço: concedem acesso administrativo ao backend.
# Mantenha apenas na sua máquina.
serviceAccount.json
*serviceAccount*.json

# Cache e logs
*-debug.log

# Cache e temporários do agente
.agents_tmp/
.agent_tmp/

# Sistema operacional e editores
.DS_Store
Thumbs.db
*.swp
*~

# Áudio e pacotes de sessão NUNCA pertencem ao Git.
# A biblioteca de mídia vive no Google Drive, atrás da API.
*.wav
*.aif
*.aiff
*.flac
*.mp3
*.zip
*.rar
*.7z
*.rpp
*.als
*.cpr
*.ptx
*.flp
*.bwproject
kyriosstems-firebase-adminsdk-*.json

# Backend: variáveis de ambiente e credenciais do Google Drive.
# A CA do Aiven (backend/certs/aiven-ca.pem) NÃO entra aqui: é certificado
# público e precisa ser versionado para o backend validar o TLS.
backend/.env
backend/.env.*
!backend/.env.example
backend/*serviceAccount*.json
backend/credentials*.json
backend/node_modules/
