# Dependências e artefatos de build
node_modules/
dist/
build/

# Arquivos de ambiente e credenciais locais
.env
.env.*
*.local

# Configuração real do Firebase (nunca versionar credenciais de produção).
# Mantenha js/firebase/config.js com valores de exemplo no repositório.
js/firebase/config.local.js

# Chave privada do SDK Admin: concede acesso total ao projeto.
# Gere no console do Firebase e mantenha apenas na sua máquina.
serviceAccount.json
*serviceAccount*.json

# Cache e logs dos emuladores do Firebase
.firebase/
*-debug.log

# Cache e temporários do agente
.agents_tmp/
.agent_tmp/

# Sistema operacional e editores
.DS_Store
Thumbs.db
*.swp
*~

# Áudio e pacotes de sessão NUNCA pertencem ao Git.
# A biblioteca de mídia vive no Firebase Storage.
*.wav
*.aif
*.aiff
*.flac
*.mp3
*.zip
*.rar
*.7z
*.rpp
*.als
*.cpr
*.ptx
*.flp
*.bwproject
kyriosstems-firebase-adminsdk-*.json

# Backend: variáveis de ambiente e credenciais do Google Drive.
# A CA do Aiven (backend/certs/aiven-ca.pem) NÃO entra aqui: é certificado
# público e precisa ser versionado para o backend validar o TLS.
backend/.env
backend/.env.*
!backend/.env.example
backend/*serviceAccount*.json
backend/credentials*.json
backend/node_modules/
